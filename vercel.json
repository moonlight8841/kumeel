{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/page.mjs": { "includeFiles": "{dist/template.html,dist-ssr/**,src/supabase-config.json}" },
    "api/sitemap.mjs": { "includeFiles": "{dist-ssr/**,src/supabase-config.json}" },
    "api/robots.mjs": { "includeFiles": "{dist-ssr/**,src/supabase-config.json}" }
  },
  "rewrites": [
    { "source": "/admin", "destination": "/api/page?path=/admin" },
    { "source": "/", "destination": "/api/page" },
    { "source": "/index.html", "destination": "/api/page" },
    { "source": "/about", "destination": "/api/page?path=/about" },
    { "source": "/observatory", "destination": "/api/page?path=/observatory" },
    { "source": "/salon", "destination": "/api/page?path=/salon" },
    { "source": "/ideas/:id", "destination": "/api/page?path=/ideas/:id" },
    { "source": "/writings/:id", "destination": "/api/page?path=/writings/:id" },
    { "source": "/media/:id", "destination": "/api/page?path=/media/:id" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/robots.txt", "destination": "/api/robots" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "X-Frame-Options", "value": "DENY" }
    ] }
  ]
}
