# Local administration only. Never prefix these secrets with VITE_.
supabase=
GITHUB_TOKEN=
# Public project URL and publishable/anon key live in src/supabase-config.json.
# They identify the project; access is enforced by database RLS.
# Optional canonical public HTTPS origin, without a path. Server-side only.
SITE_URL=

# Public Cloudflare Turnstile site key; never put the secret in client configuration.
TURNSTILE_SITE_KEY=

# Server only: never use a VITE_ prefix.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Server only: shared with supabase/chat.sql (store its SHA-256 there). 32+ random characters.
CHAT_RATE_SECRET=
# Optional, comma-separated: tried in order when GEMINI_MODEL is overloaded or unavailable.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-flash-latest

# Optional backup AI provider (Cloudflare Workers AI). Token needs ONLY "Workers AI: Read" (+ "Edit" if required by Cloudflare).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
# Optional, comma-separated @cf/ models tried in order.
CLOUDFLARE_AI_MODELS=@cf/meta/llama-3.3-70b-instruct-fp8-fast,@cf/meta/llama-4-scout-17b-16e-instruct
