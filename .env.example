# Local administration only. Never prefix these secrets with VITE_.
supabase=
GITHUB_TOKEN=
# Public project URL and publishable/anon key live in src/supabase-config.json.
# They identify the project; access is enforced by database RLS.
# Optional canonical public HTTPS origin, without a path. Server-side only.
SITE_URL=

# Public Cloudflare Turnstile site key; never put the secret in client configuration.
TURNSTILE_SITE_KEY=

# Server only: never use a VITE_ prefix.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Server only: shared with supabase/chat.sql (store its SHA-256 there). 32+ random characters.
CHAT_RATE_SECRET=
